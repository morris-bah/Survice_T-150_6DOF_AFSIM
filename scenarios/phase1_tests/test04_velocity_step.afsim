# ==============================================================================
# Test 04: Velocity Step Response
# ==============================================================================
# Purpose: Validate velocity controller gain (Kp=3.0 fix)
#
# Method:
#   - Hover at 50m altitude
#   - Command step velocity change from 0 to 15 m/s
#   - Monitor velocity tracking and response time
#
# Expected Results:
#   - Responsive velocity tracking (not sluggish)
#   - Achieves commanded velocity within 5-10 seconds
#   - No excessive overshoot (< 20%)
#
# Key Metrics:
#   - Rise time to 90% of target: < 10 seconds
#   - Overshoot: < 20%
#   - Steady-state error: < 1 m/s
# ==============================================================================

define_path_variable SCENARIO_NAME test04_velocity_step
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing

# Include the 6DOF platform with battery
include ../../platforms/t150_6dof_platform.afsim

# ==============================================================================
# PLATFORM TYPE WITH BATTERY PROCESSOR FOR TELEMETRY
# ==============================================================================
platform_type T150_VELOCITY_TEST_UAS T150_6DOF_UAS

   processor battery_monitor T150_BATTERY_PROCESSOR
      battery_capacity_wh 7000
      initial_soc 1.0
      nominal_voltage 46.8
      full_charge_voltage 54.6
      cutoff_voltage 39.0
      internal_resistance 0.025
      use_dynamic_power true
      power_source_key "6dof_total_power"
      hover_power_w 18000
      low_battery_warning 0.20
      voltage_sag_warning 42.0
      csv_output_file /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing/test04_velocity_step.csv
      csv_log_interval 0.5
   end_processor

end_platform_type

# ==============================================================================
# PLATFORM INSTANCE - Velocity Step Response Test
# ==============================================================================
platform t150_velocity_test T150_VELOCITY_TEST_UAS

   route
      # Start on ground
      position 35.0000n 120.0000w altitude 0 m agl speed 0 m/s

      # Climb to 50m
      position 35.00001n 120.0000w altitude 50 m agl speed 3 m/s

      # VELOCITY STEP: Accelerate to 15 m/s
      # Fly 1km North at 15 m/s
      position 35.0090n 120.0000w altitude 50 m agl speed 15 m/s

      # VELOCITY STEP: Accelerate to 25 m/s
      # Continue 1km North at 25 m/s
      position 35.0180n 120.0000w altitude 50 m agl speed 25 m/s

      # VELOCITY STEP: Decelerate to 5 m/s (braking test)
      position 35.0200n 120.0000w altitude 50 m agl speed 5 m/s stop

   end_route

end_platform

# ==============================================================================
# STATUS MESSAGES
# ==============================================================================

execute at_time 0 sec absolute
   writeln("========================================");
   writeln("  TEST 04: VELOCITY STEP RESPONSE");
   writeln("========================================");
   writeln("Purpose: Validate velocity controller (Kp=3.0)");
   writeln("Method: Step changes: 0->15->25->5 m/s");
   writeln("Expected: Rise time <10s, overshoot <20%");
   writeln("========================================");
end_execute

execute at_time 15 sec absolute
   writeln(">>> T=15s - At hover altitude, beginning velocity test");
end_execute

execute at_time 20 sec absolute
   writeln(">>> T=20s - STEP 1: Accelerating to 15 m/s");
end_execute

execute at_time 35 sec absolute
   writeln(">>> T=35s - Should be at 15 m/s cruise");
end_execute

execute at_time 45 sec absolute
   writeln(">>> T=45s - STEP 2: Accelerating to 25 m/s");
end_execute

execute at_time 55 sec absolute
   writeln(">>> T=55s - STEP 3: Decelerating to 5 m/s (brake test)");
end_execute

execute at_time 60 sec absolute
   writeln(">>> T=60s - Test complete");
   writeln("========================================");
   writeln("  CHECK: Review AER for velocity tracking");
   writeln("========================================");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

end_time 60 sec
