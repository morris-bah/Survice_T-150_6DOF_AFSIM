# ==============================================================================
# Test 07: Ground Effect Transition
# ==============================================================================
# Purpose: Validate ground effect thrust augmentation model
#
# Method:
#   - Hover at 30m altitude (no ground effect)
#   - Slow descent through ground effect zone (0-10m)
#   - Monitor power consumption as GE reduces required thrust
#   - Final hover at 1m (maximum ground effect)
#
# Expected Results:
#   - At 20m+: GE factor = 1.0 (no effect)
#   - At 10m: GE factor ~1.05
#   - At 5m: GE factor ~1.10-1.15
#   - At 1m: GE factor ~1.20-1.25 (max boost)
#   - Power consumption decreases near ground
#
# Key Metrics:
#   - GE factor range: 1.0 to 1.25
#   - Power reduction near ground: 15-20%
#   - Smooth transition (no discontinuities)
# ==============================================================================

define_path_variable SCENARIO_NAME test07_ground_effect
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing

# Include the 6DOF platform with battery
include ../../platforms/t150_6dof_platform.afsim

# ==============================================================================
# PLATFORM TYPE WITH BATTERY PROCESSOR FOR TELEMETRY
# ==============================================================================
platform_type T150_GROUND_EFFECT_TEST_UAS T150_6DOF_UAS

   processor battery_monitor T150_BATTERY_PROCESSOR
      battery_capacity_wh 7000
      initial_soc 1.0
      nominal_voltage 46.8
      full_charge_voltage 54.6
      cutoff_voltage 39.0
      internal_resistance 0.025
      use_dynamic_power true
      power_source_key "6dof_total_power"
      hover_power_w 18000
      low_battery_warning 0.20
      voltage_sag_warning 42.0
      csv_output_file /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing/test07_ground_effect.csv
      csv_log_interval 0.5
   end_processor

end_platform_type

# ==============================================================================
# PLATFORM INSTANCE - Ground Effect Test
# ==============================================================================
platform t150_ground_effect_test T150_GROUND_EFFECT_TEST_UAS

   route
      # Start on ground
      position 35.0000n 120.0000w altitude 0 m agl speed 0 m/s

      # Climb to 30m (out of ground effect)
      position 35.00001n 120.0000w altitude 30 m agl speed 3 m/s

      # Hover at 30m (baseline - no GE)
      position 35.00002n 120.0000w altitude 30 m agl speed 1 m/s

      # Slow descent through GE zone
      position 35.00003n 120.0000w altitude 20 m agl speed 1 m/s
      position 35.00004n 120.0000w altitude 15 m agl speed 1 m/s
      position 35.00005n 120.0000w altitude 10 m agl speed 1 m/s
      position 35.00006n 120.0000w altitude 7 m agl speed 1 m/s
      position 35.00007n 120.0000w altitude 5 m agl speed 1 m/s
      position 35.00008n 120.0000w altitude 3 m agl speed 0.5 m/s
      position 35.00009n 120.0000w altitude 2 m agl speed 0.5 m/s
      position 35.00010n 120.0000w altitude 1 m agl speed 0.5 m/s

      # Hover at 1m (maximum GE)
      position 35.00011n 120.0000w altitude 1 m agl speed 0.5 m/s stop

   end_route

end_platform

# ==============================================================================
# STATUS MESSAGES
# ==============================================================================

execute at_time 0 sec absolute
   writeln("========================================");
   writeln("  TEST 07: GROUND EFFECT TRANSITION");
   writeln("========================================");
   writeln("Purpose: Validate ground effect model");
   writeln("Method: Slow descent from 30m to 1m");
   writeln("Expected: GE factor 1.0->1.25, power decreases");
   writeln("========================================");
end_execute

execute at_time 15 sec absolute
   writeln(">>> T=15s - At 30m, baseline hover (no GE)");
end_execute

execute at_time 30 sec absolute
   writeln(">>> T=30s - Descending through 20m");
end_execute

execute at_time 45 sec absolute
   writeln(">>> T=45s - Entering GE zone (15m)");
end_execute

execute at_time 60 sec absolute
   writeln(">>> T=60s - At 10m, GE factor ~1.05");
end_execute

execute at_time 75 sec absolute
   writeln(">>> T=75s - At 5m, GE factor ~1.10-1.15");
end_execute

execute at_time 90 sec absolute
   writeln(">>> T=90s - At 2-3m, GE factor ~1.20");
end_execute

execute at_time 105 sec absolute
   writeln(">>> T=105s - At 1m, max GE factor ~1.25");
end_execute

execute at_time 120 sec absolute
   writeln(">>> T=120s - Test complete");
   writeln("========================================");
   writeln("  CHECK: Review CSV for power vs altitude");
   writeln("========================================");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

end_time 120 sec
