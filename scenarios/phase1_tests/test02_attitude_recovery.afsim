# ==============================================================================
# Test 02: Attitude Recovery
# ==============================================================================
# Purpose: Validate attitude stabilization PD controller (Kp=8.0, Kd=2.0)
#
# Method:
#   - Start hovering at 50m
#   - The 6DOF controller corrects any attitude disturbances
#   - Monitor roll/pitch angles during flight maneuvers
#   - Sharp waypoint turns induce attitude changes for recovery testing
#
# Expected Results:
#   - Attitude settles within 2-3 seconds after disturbance
#   - Overshoot < 20%
#   - No sustained oscillations
#
# Key Metrics:
#   - Settling time: < 3 seconds
#   - Overshoot: < 20%
#   - Damping: critically damped or slightly underdamped
# ==============================================================================

define_path_variable SCENARIO_NAME test02_attitude_recovery
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing

# Include the 6DOF platform with battery
include ../../platforms/t150_6dof_platform.afsim

# ==============================================================================
# PLATFORM TYPE WITH BATTERY PROCESSOR FOR TELEMETRY
# ==============================================================================
platform_type T150_ATTITUDE_TEST_UAS T150_6DOF_UAS

   processor battery_monitor T150_BATTERY_PROCESSOR
      battery_capacity_wh 7000
      initial_soc 1.0
      nominal_voltage 46.8
      full_charge_voltage 54.6
      cutoff_voltage 39.0
      internal_resistance 0.025
      use_dynamic_power true
      power_source_key "6dof_total_power"
      hover_power_w 18000
      low_battery_warning 0.20
      voltage_sag_warning 42.0
      csv_output_file /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing/test02_attitude_recovery.csv
      csv_log_interval 0.1
   end_processor

end_platform_type

# ==============================================================================
# PLATFORM INSTANCE - Attitude Recovery Test
# ==============================================================================
platform t150_attitude_test T150_ATTITUDE_TEST_UAS

   route
      # Start on ground
      position 35.0000n 120.0000w altitude 0 m agl speed 0 m/s

      # Climb to 50m
      position 35.00001n 120.0000w altitude 50 m agl speed 3 m/s

      # Sharp 90-degree turns to induce attitude changes
      # Turn 1: East
      position 35.0002n 119.9995w altitude 50 m agl speed 10 m/s

      # Turn 2: North (90 degree turn)
      position 35.0006n 119.9995w altitude 50 m agl speed 10 m/s

      # Turn 3: West (90 degree turn)
      position 35.0006n 120.0005w altitude 50 m agl speed 10 m/s

      # Turn 4: South (90 degree turn)
      position 35.0002n 120.0005w altitude 50 m agl speed 10 m/s

      # Return to start area and hover
      position 35.0001n 120.0000w altitude 50 m agl speed 5 m/s stop

   end_route

end_platform

# ==============================================================================
# STATUS MESSAGES
# ==============================================================================

execute at_time 0 sec absolute
   writeln("========================================");
   writeln("  TEST 02: ATTITUDE RECOVERY");
   writeln("========================================");
   writeln("Purpose: Validate attitude PD controller");
   writeln("Method: Sharp turns to induce attitude changes");
   writeln("Expected: Settle <3s, overshoot <20%");
   writeln("========================================");
end_execute

execute at_time 10 sec absolute
   writeln(">>> T=10s - At hover altitude, beginning maneuvers");
end_execute

execute at_time 20 sec absolute
   writeln(">>> T=20s - Turn 1 (East) - attitude recovery test");
end_execute

execute at_time 30 sec absolute
   writeln(">>> T=30s - Turn 2 (North) - attitude recovery test");
end_execute

execute at_time 40 sec absolute
   writeln(">>> T=40s - Turn 3 (West) - attitude recovery test");
end_execute

execute at_time 50 sec absolute
   writeln(">>> T=50s - Turn 4 (South) - attitude recovery test");
end_execute

execute at_time 60 sec absolute
   writeln(">>> T=60s - Test complete");
   writeln("========================================");
   writeln("  CHECK: Review AER for attitude angles");
   writeln("========================================");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

end_time 60 sec
