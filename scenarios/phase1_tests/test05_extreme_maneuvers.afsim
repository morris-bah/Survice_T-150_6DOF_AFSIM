# ==============================================================================
# Test 05: Extreme Maneuvers - Numerical Stability
# ==============================================================================
# Purpose: Test numerical stability of 6DOF integrator under stress
#
# Method:
#   - Rapid altitude changes (5+ m/s vertical)
#   - High-speed turns requiring max bank angle
#   - Aggressive acceleration/deceleration
#   - Monitor for NaN, position explosion, or integrator divergence
#
# Expected Results:
#   - No NaN values in any output
#   - No position/velocity explosion
#   - Stable quaternion (normalized)
#   - Physics remain bounded
#
# Key Metrics:
#   - No NaN: PASS/FAIL
#   - Position bounded: < 10km from origin
#   - Velocity bounded: < 100 m/s
#   - Altitude bounded: 0-1000m
# ==============================================================================

define_path_variable SCENARIO_NAME test05_extreme_maneuvers
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing

# Include the 6DOF platform with battery
include ../../platforms/t150_6dof_platform.afsim

# ==============================================================================
# PLATFORM TYPE WITH BATTERY PROCESSOR FOR TELEMETRY
# ==============================================================================
platform_type T150_EXTREME_TEST_UAS T150_6DOF_UAS

   processor battery_monitor T150_BATTERY_PROCESSOR
      battery_capacity_wh 7000
      initial_soc 1.0
      nominal_voltage 46.8
      full_charge_voltage 54.6
      cutoff_voltage 39.0
      internal_resistance 0.025
      use_dynamic_power true
      power_source_key "6dof_total_power"
      hover_power_w 18000
      low_battery_warning 0.20
      voltage_sag_warning 42.0
      csv_output_file /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing/test05_extreme_maneuvers.csv
      csv_log_interval 0.5
   end_processor

end_platform_type

# ==============================================================================
# PLATFORM INSTANCE - Extreme Maneuvers Test
# ==============================================================================
platform t150_extreme_test T150_EXTREME_TEST_UAS

   route
      # Start on ground
      position 35.0000n 120.0000w altitude 0 m agl speed 0 m/s

      # EXTREME 1: Rapid climb (5 m/s vertical)
      position 35.00001n 120.0000w altitude 100 m agl speed 5 m/s

      # EXTREME 2: High-speed dash
      position 35.0050n 120.0000w altitude 100 m agl speed 30 m/s

      # EXTREME 3: Sharp turn at speed (high bank angle)
      position 35.0050n 119.9950w altitude 100 m agl speed 25 m/s

      # EXTREME 4: Rapid descent
      position 35.0051n 119.9949w altitude 20 m agl speed 5 m/s

      # EXTREME 5: Quick climb again
      position 35.0060n 119.9940w altitude 150 m agl speed 5 m/s

      # EXTREME 6: High-speed run with sharp turn
      position 35.0100n 119.9940w altitude 150 m agl speed 30 m/s
      position 35.0100n 120.0000w altitude 150 m agl speed 25 m/s

      # EXTREME 7: Aggressive descent to near ground
      position 35.0050n 120.0000w altitude 5 m agl speed 5 m/s

      # EXTREME 8: Pop-up maneuver
      position 35.0051n 120.0000w altitude 80 m agl speed 5 m/s

      # Final descent and land
      position 35.0052n 120.0000w altitude 0 m agl speed 2 m/s stop

   end_route

end_platform

# ==============================================================================
# STATUS MESSAGES
# ==============================================================================

execute at_time 0 sec absolute
   writeln("========================================");
   writeln("  TEST 05: EXTREME MANEUVERS");
   writeln("========================================");
   writeln("Purpose: Test numerical stability under stress");
   writeln("Method: Rapid climbs, high-speed turns, aggressive maneuvers");
   writeln("Expected: No NaN, no divergence, stable physics");
   writeln("========================================");
end_execute

execute at_time 20 sec absolute
   writeln(">>> T=20s - Rapid climb complete, high-speed dash");
end_execute

execute at_time 40 sec absolute
   writeln(">>> T=40s - Sharp turns and altitude changes");
end_execute

execute at_time 60 sec absolute
   writeln(">>> T=60s - High-speed run with aggressive maneuvers");
end_execute

execute at_time 80 sec absolute
   writeln(">>> T=80s - Near-ground maneuvers");
end_execute

execute at_time 100 sec absolute
   writeln(">>> T=100s - Pop-up and landing sequence");
end_execute

execute at_time 120 sec absolute
   writeln(">>> T=120s - Test complete");
   writeln("========================================");
   writeln("  CHECK: Verify no NaN or divergence");
   writeln("========================================");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

end_time 120 sec
