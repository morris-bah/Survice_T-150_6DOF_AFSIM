# ==============================================================================
# Test 06: Voltage Sag Under Low SOC
# ==============================================================================
# Purpose: Validate battery voltage model under high load at low SOC
#
# Method:
#   - Start with 30% SOC (low battery state)
#   - Perform aggressive maneuvers requiring high power
#   - Monitor voltage sag as internal resistance increases
#   - Verify 42V warning triggers
#
# Expected Results:
#   - Voltage sag increases significantly at low SOC (3x resistance)
#   - 42V warning triggers as terminal voltage drops
#   - OCV vs terminal voltage shows increasing gap
#
# Key Metrics:
#   - Voltage sag at 30% SOC: 2-4V under load
#   - 42V warning: Should trigger during high-power maneuvers
#   - Current draw: 300-500A peak
# ==============================================================================

define_path_variable SCENARIO_NAME test06_voltage_sag
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing

# Include the 6DOF platform
include ../../platforms/t150_6dof_platform.afsim

# ==============================================================================
# PLATFORM TYPE WITH LOW SOC BATTERY
# ==============================================================================
platform_type T150_VOLTAGE_SAG_TEST_UAS T150_6DOF_UAS

   processor battery_monitor T150_BATTERY_PROCESSOR
      battery_capacity_wh 7000
      initial_soc 0.30               # START AT 30% SOC (low battery)
      nominal_voltage 46.8
      full_charge_voltage 54.6
      cutoff_voltage 39.0
      internal_resistance 0.025
      use_dynamic_power true
      power_source_key "6dof_total_power"
      hover_power_w 18000
      low_battery_warning 0.20
      voltage_sag_warning 42.0
      csv_output_file /home/shepard/afsim_projects/project005_t150_uas/output/phase1_testing/test06_voltage_sag.csv
      csv_log_interval 0.5
   end_processor

end_platform_type

# ==============================================================================
# PLATFORM INSTANCE - Voltage Sag Test
# ==============================================================================
platform t150_voltage_sag_test T150_VOLTAGE_SAG_TEST_UAS

   route
      # Start on ground
      position 35.0000n 120.0000w altitude 0 m agl speed 0 m/s

      # High-power climb (stress test battery)
      position 35.00001n 120.0000w altitude 100 m agl speed 5 m/s

      # High-speed cruise (high power draw)
      position 35.0100n 120.0000w altitude 100 m agl speed 30 m/s

      # Aggressive maneuvers (max power)
      position 35.0100n 119.9900w altitude 100 m agl speed 25 m/s
      position 35.0150n 119.9900w altitude 150 m agl speed 25 m/s
      position 35.0150n 120.0000w altitude 100 m agl speed 25 m/s

      # Continue high-power operations
      position 35.0200n 120.0000w altitude 100 m agl speed 30 m/s
      position 35.0200n 119.9900w altitude 150 m agl speed 25 m/s

      # Final descent
      position 35.0180n 119.9950w altitude 0 m agl speed 2 m/s stop

   end_route

end_platform

# ==============================================================================
# STATUS MESSAGES
# ==============================================================================

execute at_time 0 sec absolute
   writeln("========================================");
   writeln("  TEST 06: VOLTAGE SAG STRESS TEST");
   writeln("========================================");
   writeln("Purpose: Validate voltage sag at low SOC");
   writeln("Initial SOC: 30%");
   writeln("Expected: 42V warning, increased sag");
   writeln("========================================");
end_execute

execute at_time 30 sec absolute
   writeln(">>> T=30s - High-power climb complete");
end_execute

execute at_time 60 sec absolute
   writeln(">>> T=60s - High-speed cruise, check voltage sag");
end_execute

execute at_time 120 sec absolute
   writeln(">>> T=120s - Aggressive maneuvers, max power draw");
end_execute

execute at_time 180 sec absolute
   writeln(">>> T=180s - Continued high-power ops");
end_execute

execute at_time 240 sec absolute
   writeln(">>> T=240s - Nearing 20% SOC warning threshold");
end_execute

execute at_time 300 sec absolute
   writeln(">>> T=300s - Test complete");
   writeln("========================================");
   writeln("  CHECK: Review CSV for voltage sag data");
   writeln("========================================");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

end_time 300 sec
