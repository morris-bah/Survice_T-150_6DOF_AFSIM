# ==============================================================================
# Radar Vertical Detection Test
# ==============================================================================
# Determines at what altitude a T-150 is first detected by ground radar
# when rising vertically from 20km away.
# ==============================================================================

define_path_variable SCENARIO_NAME radar_vertical_detection
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output

# Include dependencies
include ../../signatures/t150_radar_signature.afsim
include ../../sensors/ground_surveillance_radar.afsim
include ../../platforms/t150_6dof_platform.afsim

# ==============================================================================
# RADAR SITE PLATFORM
# ==============================================================================
platform_type RADAR_SITE_VERTICAL WSF_PLATFORM
   side blue
   icon radar_site
   category ground

   sensor surveillance GROUND_SURVEILLANCE_RADAR
      on
      processor track_proc
   end_sensor

   processor track_proc WSF_TRACK_PROCESSOR
   end_processor

   processor monitor_proc WSF_SCRIPT_PROCESSOR
      update_interval 1 sec

      script_variables
         bool mDetected = false;
         double mDetectionTime = 0.0;
         double mDetectionAltitude = 0.0;
         double mDetectionRange = 0.0;
      end_script_variables

      on_update
         if (!mDetected)
         {
            WsfLocalTrackList trackList = PLATFORM.MasterTrackList();
            if (trackList.TrackCount() > 0)
            {
               mDetected = true;
               mDetectionTime = TIME_NOW;

               # Get actual drone altitude
               WsfPlatform drone = WsfSimulation.FindPlatform("t150_climber");
               if (drone.IsValid())
               {
                  mDetectionAltitude = drone.Altitude();
               }

               foreach (WsfTrack track in trackList)
               {
                  if (track.RangeValid())
                  {
                     mDetectionRange = track.Range() / 1000.0;
                  }
                  break;
               }

               writeln("");
               writeln("========================================");
               writeln(">>> FIRST DETECTION!");
               writeln("========================================");
               writeln("Time: ", mDetectionTime, " sec");
               writeln("Slant Range: ", mDetectionRange, " km");
               writeln("Drone Altitude: ", mDetectionAltitude, " m");
               writeln("========================================");
               writeln("");
            }
         }
      end_on_update
   end_processor

end_platform_type

# ==============================================================================
# T-150 VERTICAL CLIMB PLATFORM (simplified - no battery for this test)
# ==============================================================================
platform_type T150_VERTICAL_CLIMB WSF_PLATFORM
   side red
   icon 4_rotor_good
   category air

   mover WSF_AIR_MOVER
      update_interval 0.1 sec
   end_mover

   radar_signature T150_HIGH_FIDELITY_RCS

end_platform_type

# ==============================================================================
# PLATFORM INSTANCES
# ==============================================================================

# Radar site at origin
platform radar_site RADAR_SITE_VERTICAL
   position 35.0n 120.0w altitude 0 m msl
end_platform

# T-150 starting 20 km south, climbing nearly vertically
# 20 km south = approximately 0.18 degrees latitude
# Adding tiny northward drift to avoid coincident waypoints
platform t150_climber T150_VERTICAL_CLIMB
   route
      # Start at ground level, 20 km south
      position 34.820n 120.0w altitude 1 m agl speed 1 m/s

      # Climb to 100m (tiny drift north)
      position 34.8201n 120.0w altitude 100 m agl speed 5 m/s

      # Climb to 250m
      position 34.8202n 120.0w altitude 250 m agl speed 5 m/s

      # Climb to 500m
      position 34.8203n 120.0w altitude 500 m agl speed 5 m/s

      # Climb to 750m
      position 34.8204n 120.0w altitude 750 m agl speed 5 m/s

      # Climb to 1000m
      position 34.8205n 120.0w altitude 1000 m agl speed 5 m/s

      # Climb to 1500m
      position 34.8206n 120.0w altitude 1500 m agl speed 5 m/s

      # Climb to 2000m
      position 34.8207n 120.0w altitude 2000 m agl speed 5 m/s

   end_route
end_platform

# ==============================================================================
# ALTITUDE REPORTING
# ==============================================================================
execute at_time 0 sec absolute
   writeln("============================================================");
   writeln("  RADAR VERTICAL DETECTION TEST");
   writeln("============================================================");
   writeln("Radar Site: 35.0N, 120.0W (at ground level)");
   writeln("T-150 Start: 20 km south, at ground level");
   writeln("T-150 climbing vertically at 5 m/s");
   writeln("Radar: S-band, 40km range for 1m^2 target");
   writeln("T-150 RCS: -3 to +12 dBsm depending on aspect");
   writeln("============================================================");
   writeln("");
end_execute

# Report altitude periodically
execute at_interval_of 10 sec
   WsfPlatform drone = WsfSimulation.FindPlatform("t150_climber");
   if (drone.IsValid())
   {
      writeln("T=", TIME_NOW, "s | Altitude: ", drone.Altitude(), " m");
   }
end_execute

# End simulation
execute at_time 400 sec absolute
   writeln("");
   writeln("============================================================");
   writeln("  SIMULATION COMPLETE");
   writeln("============================================================");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

end_time 400 sec
