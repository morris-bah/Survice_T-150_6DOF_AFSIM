# ==============================================================================
# Battery Test: Square Wave Pattern - TIME-BASED
# ==============================================================================
# Tests battery consumption for 90-degree turn pattern over a fixed 500 second
# cruise phase. Alternating N/E/N/W segments with sharp 90° direction changes.
#
# Test Design:
#   - Climb to 350m AGL (~70 seconds)
#   - Fly square wave pattern for 500 seconds at 30 m/s
#   - Descend and land (~60 seconds)
#
# Pattern: Alternating N and E/W segments with 90° turns
# Each cycle: 400m N, 300m E, 400m N, 300m W = 1400m, ~47s per cycle
# ==============================================================================

define_path_variable SCENARIO_NAME battery_test_square
define_path_variable OUTPUT_DIR /home/shepard/afsim_projects/project005_t150_uas/output

# Include the 6DOF mover definition
include ../../platforms/t150_6dof_mover.afsim

# ==============================================================================
# PLATFORM TYPE WITH BATTERY PROCESSOR
# ==============================================================================
platform_type T150_BATTERY_TEST_UAS WSF_PLATFORM

   side blue
   icon 4_rotor_good
   category air

   # 6DOF physics-based mover
   mover T150_6DOF_MOVER
   end_mover

   # Battery processor - reads power from 6DOF mover
   processor BATTERY_MONITOR T150_BATTERY_PROCESSOR
      battery_capacity_wh 7000
      initial_soc 1.0
      nominal_voltage 46.8
      full_charge_voltage 54.6
      cutoff_voltage 39.0
      internal_resistance 0.025
      use_dynamic_power true
      power_source_key "6dof_total_power"
      hover_power_w 18000
      low_battery_warning 0.20
      voltage_sag_warning 42.0
      csv_output_file /home/shepard/afsim_projects/project005_t150_uas/output/battery_test_square_battery.csv
      csv_log_interval 1.0
   end_processor

end_platform_type

# ==============================================================================
# PLATFORM INSTANCE
# ==============================================================================
platform t150_battery_test T150_BATTERY_TEST_UAS

   route
      # =========================================
      # PHASE 1: Takeoff and Climb to 350m
      # =========================================
      position 35.0000n 120.0000w altitude 0 m agl speed 0 m/s
      position 35.0001n 120.0000w altitude 350 m agl speed 5 m/s

      # =========================================
      # PHASE 2: Square Wave Pattern for 500 seconds
      # Pattern: N 400m, E 300m, N 400m, W 300m (back to centerline)
      # 400m N = 0.0036 deg lat, 300m E/W = 0.0027 deg lon
      # Each full cycle ~47s, need ~11 cycles for 500s
      # =========================================

      # Cycle 1
      position 35.0037n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0037n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0073n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0073n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 2
      position 35.0109n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0109n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0145n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0145n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 3
      position 35.0181n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0181n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0217n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0217n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 4
      position 35.0253n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0253n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0289n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0289n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 5
      position 35.0325n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0325n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0361n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0361n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 6
      position 35.0397n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0397n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0433n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0433n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 7
      position 35.0469n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0469n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0505n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0505n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 8
      position 35.0541n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0541n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0577n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0577n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 9
      position 35.0613n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0613n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0649n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0649n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 10
      position 35.0685n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0685n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0721n 120.0027w altitude 350 m agl speed 30 m/s
      position 35.0721n 120.0000w altitude 350 m agl speed 30 m/s

      # Cycle 11
      position 35.0757n 120.0000w altitude 350 m agl speed 30 m/s
      position 35.0757n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0793n 119.9973w altitude 350 m agl speed 30 m/s
      position 35.0793n 120.0000w altitude 350 m agl speed 30 m/s

      # Final approach to landing zone
      position 35.0830n 120.0000w altitude 350 m agl speed 30 m/s

      # =========================================
      # PHASE 3: Descent and Landing
      # =========================================
      position 35.0840n 120.0000w altitude 50 m agl speed 5 m/s
      position 35.0845n 120.0000w altitude 0 m agl speed 2 m/s stop

   end_route

end_platform

# ==============================================================================
# STATUS MESSAGES
# ==============================================================================

execute at_time 0 sec absolute
   writeln("========================================");
   writeln("  BATTERY TEST: SQUARE WAVE (TIMED)");
   writeln("========================================");
   writeln("Test Design: 500 second cruise phase");
   writeln("Pattern: 90-degree turns, N/E/N/W");
   writeln("Speed: 30 m/s cruise");
   writeln("========================================");
end_execute

execute at_time 70 sec absolute
   writeln(">>> T=70s - Reached cruise altitude, beginning 500s cruise phase");
end_execute

execute at_time 320 sec absolute
   writeln(">>> T=320s - Mid-cruise (250s into cruise phase)");
end_execute

execute at_time 570 sec absolute
   writeln(">>> T=570s - End of 500s cruise phase, beginning descent");
end_execute

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
event_pipe
   file $(OUTPUT_DIR)/$(SCENARIO_NAME).aer
   use_preset default
end_event_pipe

# Total time: ~70s climb + 500s cruise + 60s descent + buffer
end_time 680 sec
