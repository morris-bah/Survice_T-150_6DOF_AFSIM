% Define the custom glossary style
\newglossarystyle{doMyStyle}{
    \setglossarystyle{list}
    \renewenvironment{theglossary}{
        \begin{longtable}{|>{\centering}m{.75in} >{\raggedright}m{4.5in}:>{\raggedleft\arraybackslash}m{1.25in}|}\hline
            \multicolumn{3}{|l|}{\unclasslabel}\\\hline
			\rowcolor{TableBlue}\multicolumn{1}{|c|}{\textcolor{white}{\textbf{Term}}} & \multicolumn{1}{|c|}{\textcolor{white}{\textbf{Description}}} & \multicolumn{1}{c|}{{\textcolor{white}{\textbf{Page}}}}\\\hline
            \endhead
			\multicolumn{3}{|r|}{\unclasslabel}\\\hline
            \multicolumn{3}{c}{\textit{Continued on next page}} \\
            \endfoot
            \multicolumn{3}{|r|}{\unclasslabel}\\\hline
            \endlastfoot
    }{
        \end{longtable}
    }
    \renewcommand*{\glossaryheader}{}
    \renewcommand*{\glsgroupheading}[1]{}
    \renewcommand*{\glossentry}[2]{
        \glstarget{##1}{\small\glossentryname{##1}}&\textit{\small\glossentrydesc{##1}}&\tiny##2\\\hline
    }
}
\setglossarystyle{doMyStyle}

% just print the glossary with this
\newcommand{\doPrintGloss}{
	\pagebreak
	\section{\unclass Acronyms}\label{acronyms}
	\vspace{-.75in}
	\printnoidxglossary[type=\acronymtype, title=]
	\pagebreak
}

