% define figure env
\newcommand{\doMyFigure}[5]{
    \begin{figure}[H]\begin{center}
        \fbox{\parbox{#1}{
        {\vspace{.25em}\hspace{.25em}}\raggedright#2\vspace{.25em}
        
        \centering\includegraphics[width=#1-.5em]{#3}\vspace{1em}
        \caption{#4}
        \label{fig:#5}
        \raggedleft#2{\vspace{.25em}\hspace{.25em}}
        }}
    \end{center}\end{figure}
    \vspace{-.25in}
}

% define fast figure env
\newcommand{\figHere}[2]{
