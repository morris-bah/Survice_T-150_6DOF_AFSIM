% define landscape figure env
\newcommand{\doMyFigureLS}[5]{
    \newgeometry{left=1cm, right=1cm, top=1cm, bottom=1cm}
    \begin{landscape}
    \thispagestyle{clear}
        \begin{center}
            \classlabel
        \begin{figure}[H]
            \fbox{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{ % change here
            {\vspace{.5em}\hspace{.5em}}\raggedright#2\vspace{1em}
            
            \centering\includegraphics[width=#1]{#3}\vspace{1em}
            \caption{#4}\vspace{1em}
            \label{fig:#5}
            \raggedleft#2{\vspace{.5em}\hspace{.5em}}
            }}
        \end{figure}
            \vspace*{\fill}
            \vbox{\classlabel\ \\ \footnotesize{Page \thepage\ of \pageref{LastPage}}}
        \end{center}
    \end{landscape}
    \restoregeometry
}

% define gif env
\newcommand{\doMyGif}[8]{
    \begin{figure}[H]\begin{center}
        \fbox{\parbox{#1}{
        {\vspace{.5em}\hspace{.5em}}\raggedright#2\vspace{1em}
        
        \centering\animategraphics[width=#1-4em,autoplay,loop,controls]{#6}{#3}{#4}{#5}\vspace{1em}
        \caption{#7}\vspace{1em}
        \label{fig:#8}
        \raggedleft#2{\vspace{.5em}\hspace{.5em}}
        }}
    \end{center}\end{figure}
}

% equation env
\newcommand{\doMyEquation}[4]{
    \vspace{.75em}
    \vbox{\centering
        \begin{mdframed}[linewidth=1pt, linecolor=black, userdefinedwidth=\textwidth]
        \hspace{-.5em}\raggedright#1\\      	
        \begin{equation}\label{eqn:#3}
            #4
        \end{equation}\vspace{1em}
        
        \centering\textbf{\unclass #2}
        
        \raggedleft#1\hspace{-.5em}
    \end{mdframed}}
}

% subequations env
\newcommand{\doMySubequations}[4]{
    \vspace{.75em}
    \vbox{\centering\textbf{\unclass #2}\vspace{.25em}\\
        \begin{mdframed}[linewidth=1pt, linecolor=black, userdefinedwidth=\textwidth]
        \hspace{-.5em}\raggedright#1
        \begin{subequations}\label{eqn:#3}
        \begin{align}
            #4
        \end{align}
        \end{subequations}
        \raggedleft#1\hspace{-.5em}
    \end{mdframed}}
}

% define landscape env
\newcommand{\LSHere}[1]{
    \newgeometry{left=1cm, right=1cm, top=1cm, bottom=1cm}
    \begin{landscape}
    \thispagestyle{clear}
        \begin{center}
            \classlabel
            \vspace{-.1in}
            #1
            \vspace*{\fill}
            \vbox{\classlabel\ \\ \footnotesize{Page \thepage\ of \pageref{LastPage}}}
        \end{center}
    \end{landscape}
    \restoregeometry
}


