        \centering\includegraphics[width=\textwidth-1.5em]{#2}\vspace{1em}
        \caption{#1}
        \label{fig:#1}
        \raggedleft\unclasslabel{\vspace{.25em}\hspace{.25em}}
        }}
    \end{center}\end{figure}
    \vspace{-.25in}
}

