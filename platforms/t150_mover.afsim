# ==============================================================================
# T-150 / TRV-150 Heavy-Lift UAS Mover Definition
# ==============================================================================
# Malloy Aeronautics T-150 / SURVICE TRV-150 Tactical Resupply Vehicle
#
# Configuration: Coaxial Octocopter (8 rotors on 4 arms)
# Propulsion: 8x T-Motor U15II KV100 motors
# Battery: 13S Li-Ion, 46.8V nominal, ~7 kWh capacity
# MTOW: 123 kg (271 lbs)
# Max Payload: 68 kg (150 lbs)
#
# Data sources:
# - Operational_Envelope_and_Technical_Characterization.txt
# - battery_engineering_assessment.txt
# - AAIB Accident Investigation Report
# ==============================================================================

mover T150_MOVER WSF_FULL_ROTORCRAFT_MOVER

   update_interval 0.1 sec
   switch_on_passing
   write_diagnostic_file true
   log_exceedances_to_file true
   use_thought_bubbles true

   rotorcraft_kinematics

      # ========================================================================
      # PERFORMANCE LIMITS - Operationally available (software-governed) values
      # These represent the safe operational envelope
      # ========================================================================
      performance_limits

         # Cruise speed: 30 m/s (108 km/h) - manufacturer stated
         available_airspeed             30 m/s

         # Rate of ascent: 5 m/s operational (limited by battery C-rating)
         available_rate_of_ascent       5 m/s

         # Ascent path angle - vertical capability
         available_ascent_path_angle    90 deg

         # Rate of descent: 3 m/s (safety buffer below VRS onset at 4-5 m/s)
         available_rate_of_descent      3 m/s

         # Descent path angle - vertical capability
         available_descent_path_angle   90 deg

         # Operational altitude limit (500m AGL for this mission, but can go higher)
         available_altitude             3000 m

         # Turn rate: 25 deg/s in auto modes
         available_turn_rate            25 deg/s

      end_performance_limits

      # ========================================================================
      # GLOBAL LIMITS - Physical "do not exceed" parameters
      # These represent hard aerodynamic/structural boundaries
      # ========================================================================
      global_limits

         # Maximum airspeed: >40 m/s aerodynamically possible, but governed to 30 m/s
         # Using 40 m/s as physical limit based on accident investigation data
         maximum_airspeed               40 m/s

         # Maximum crab speed: 12 m/s (limited by side profile drag)
         maximum_crab_speed             12 m/s

         # Maximum hover speed: 10 m/s (definition of hover mode transition)
         maximum_hover_speed            10 m/s

         # Maximum rate of ascent: 8 m/s (battery current limited)
         maximum_rate_of_ascent         8 m/s

         # Maximum ascent path angle: vertical
         maximum_ascent_path_angle      90 deg

         # Maximum rate of descent: 4 m/s (VRS onset threshold)
         maximum_rate_of_descent        4 m/s

         # Maximum descent path angle: vertical
         maximum_descent_path_angle     90 deg

         # Maximum bank angle: 60.9 deg (demonstrated in AAIB accident)
         maximum_bank_angle             60 deg

         # Maximum altitude: 3000 m (estimated service ceiling)
         maximum_altitude               3000 m

         # Minimum altitude: ground level
         minimum_altitude               0 m

         # Hover acceleration: 0.2 g (dampened for stability)
         maximum_hover_acceleration_magnitude 0.2 g

         # Axial acceleration: 3.0 m/s^2 (allow for full acceleration table range)
         maximum_axial_acceleration     0.35 g

         # Axial deceleration: 3.5 m/s^2 (controlled braking)
         maximum_axial_deceleration     0.35 g

         # Radial/lateral acceleration: 4 m/s^2
         maximum_radial_acceleration    0.4 g

         # Turn rate: 45 deg/s maximum
         maximum_turn_rate              45 deg/s

         # Yaw rate: 90 deg/s (limited by rotational inertia)
         maximum_yaw_rate               90 deg/s

         # Pitch rate: 100 deg/s (high authority for stabilization)
         maximum_pitch_rate             100 deg/s

         # Roll rate: 100 deg/s (high authority for stabilization)
         maximum_roll_rate              100 deg/s

         # Minimum airspeed: 0 (hover capable)
         minimum_airspeed               0 m/s

         # Minimum turn radius: 1m (effectively can pivot in place)
         minimum_turn_radius            1 m

         # Maximum load factor acceleration: 2G structural limit
         maximum_load_factor_acceleration 2.0 g

         # Maximum load factor: 2.0 (utility airframe limit)
         maximum_load_factor            2.0

      end_global_limits

      # ========================================================================
      # RUN-TIME GAINS - Control system tuning parameters
      # Tuned for heavy-lift octocopter with high rotational inertia
      # REVISED v4: Back to v2 gains that reached waypoint 11
      # ========================================================================
      run_time_gains

         # Vertical control
         vertical_offset_to_speed_gain            0.12

         # Attitude control gains - moderate
         heading_error_to_yaw_rate_gain           0.20
         pitch_error_to_pitch_rate_gain           0.15
         roll_error_to_roll_rate_gain             0.20

         # Waypoint navigation - balanced settings from v2
         waypoint_proportional_navigation_gain    50.0
         waypoint_velocity_pursuit_gain           10.0

         # Deceleration control - slightly increased for sharp turns
         deceleration_table_adjustment_gain       1.8
         hover_damping_deceleration_gain          0.90

         # Position hold
         hover_position_nulling_gain              0.08

      end_run_time_gains

      # ========================================================================
      # FEEDBACK CONTROL SYSTEM - PID controllers for flight dynamics
      # ========================================================================
      feedback_control_system

         axial_acceleration_pid
            proportional_gain 1.0
            integral_gain     0.05
            derivative_gain   0.1
         end_axial_acceleration_pid

         lateral_acceleration_pid
            proportional_gain 2.0
            integral_gain     0.0
            derivative_gain   0.5
         end_lateral_acceleration_pid

         vertical_acceleration_pid
            proportional_gain 1.5
            integral_gain     0.1
            derivative_gain   0.2
         end_vertical_acceleration_pid

      end_feedback_control_system

      # ========================================================================
      # ACCELERATION TABLE - Time-based acceleration profiles
      # Based on working demo configuration
      # ========================================================================
      acceleration_table
         delta_time_for_auto_generation      0.5 s
         maximum_speed_for_auto_generation  100 m/s
         point time 0 s acceleration 0.3 g end_point
         point time 8 s acceleration 0.2 g end_point
         point time 20 s acceleration 0.15 g end_point
         point time 50 s acceleration 0.1 g end_point
      end_acceleration_table

   end_rotorcraft_kinematics

   # ===========================================================================
   # PERFORMANCE TABLES - Variable performance based on altitude and airspeed
   # Simplified tables for T-150 electric propulsion
   # ===========================================================================
   performance_tables
      initial_mode DEFAULT

      known_mode DEFAULT
         tables
            maximum_acceleration_table
            maximum_deceleration_table
            maximum_cruise_airspeed_table
            maximum_rate_of_ascent_table
            maximum_rate_of_descent_table
            maximum_roll_rate_table
            maximum_bank_angle_table
         end_tables
      end_known_mode

      known_mode HOVER
         tables
            maximum_hover_airspeed_table
         end_tables
      end_known_mode

      # -----------------------------------------------------------------------
      # Acceleration table: varies with altitude (air density affects thrust)
      # At 123 kg MTOW with 240 kg thrust available
      # -----------------------------------------------------------------------
      table available_axial_acceleration maximum_acceleration_table
         regular_table
            independent_variable altitude
               units m
               0 500 1000 1500 2000 2500 3000
            end_independent_variable
            independent_variable airspeed
               units m/s
               0 5 10 15 20 25 30
            end_independent_variable
            dependent_variable
               units m/s2
               # Sea level - full thrust available
               2.5 2.5 2.4 2.3 2.2 2.0 1.8   # 0m altitude
               2.4 2.4 2.3 2.2 2.1 1.9 1.7   # 500m altitude
               2.3 2.3 2.2 2.1 2.0 1.8 1.6   # 1000m altitude
               2.2 2.2 2.1 2.0 1.9 1.7 1.5   # 1500m altitude
               2.0 2.0 1.9 1.8 1.7 1.5 1.3   # 2000m altitude
               1.8 1.8 1.7 1.6 1.5 1.3 1.1   # 2500m altitude
               1.5 1.5 1.4 1.3 1.2 1.0 0.8   # 3000m altitude (service ceiling)
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Deceleration table: similar profile to acceleration
      # -----------------------------------------------------------------------
      table available_axial_deceleration maximum_deceleration_table
         regular_table
            independent_variable altitude
               units m
               0 500 1000 1500 2000 2500 3000
            end_independent_variable
            independent_variable airspeed
               units m/s
               0 5 10 15 20 25 30
            end_independent_variable
            dependent_variable
               units m/s2
               3.0 3.0 2.9 2.8 2.7 2.5 2.3   # 0m altitude
               2.9 2.9 2.8 2.7 2.6 2.4 2.2   # 500m altitude
               2.8 2.8 2.7 2.6 2.5 2.3 2.1   # 1000m altitude
               2.7 2.7 2.6 2.5 2.4 2.2 2.0   # 1500m altitude
               2.5 2.5 2.4 2.3 2.2 2.0 1.8   # 2000m altitude
               2.3 2.3 2.2 2.1 2.0 1.8 1.6   # 2500m altitude
               2.0 2.0 1.9 1.8 1.7 1.5 1.3   # 3000m altitude
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Cruise airspeed table: 30 m/s max, reduced at altitude
      # -----------------------------------------------------------------------
      table available_airspeed maximum_cruise_airspeed_table
         regular_table
            independent_variable altitude
               units m
               0 500 1000 1500 2000 2500 3000
            end_independent_variable
            dependent_variable
               units m/s
               30 30 29 28 26 24 20
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Hover airspeed table: max 10 m/s in hover mode
      # -----------------------------------------------------------------------
      table available_airspeed maximum_hover_airspeed_table
         regular_table
            independent_variable altitude
               units m
               0 500 1000 1500 2000 2500 3000
            end_independent_variable
            dependent_variable
               units m/s
               10 10 10 9 8 7 6
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Rate of ascent table: 5 m/s operational, degraded at altitude
      # -----------------------------------------------------------------------
      table available_rate_of_ascent maximum_rate_of_ascent_table
         regular_table
            independent_variable altitude
               units m
               0 500 1000 1500 2000 2500 3000
            end_independent_variable
            independent_variable airspeed
               units m/s
               0 10 20 30
            end_independent_variable
            dependent_variable
               units m/s
               # Climb rate decreases with altitude (less excess thrust)
               5.0 5.0 4.5 4.0   # 0m
               4.8 4.8 4.3 3.8   # 500m
               4.5 4.5 4.0 3.5   # 1000m
               4.0 4.0 3.5 3.0   # 1500m
               3.5 3.5 3.0 2.5   # 2000m
               2.5 2.5 2.0 1.5   # 2500m
               1.5 1.5 1.0 0.5   # 3000m (service ceiling - minimal climb)
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Rate of descent table: 3 m/s max (VRS avoidance)
      # -----------------------------------------------------------------------
      table available_rate_of_descent maximum_rate_of_descent_table
         regular_table
            independent_variable altitude
               units m
               0 500 1000 1500 2000 2500 3000
            end_independent_variable
            independent_variable airspeed
               units m/s
               0 10 20 30
            end_independent_variable
            dependent_variable
               units m/s
               # Descent rate limited by VRS - slightly higher allowed with forward speed
               3.0 3.5 4.0 4.0   # 0m
               3.0 3.5 4.0 4.0   # 500m
               3.0 3.5 4.0 4.0   # 1000m
               3.0 3.5 4.0 4.0   # 1500m
               3.0 3.5 4.0 4.0   # 2000m
               3.0 3.5 4.0 4.0   # 2500m
               3.0 3.5 4.0 4.0   # 3000m
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Roll rate table: 45-100 deg/s
      # -----------------------------------------------------------------------
      table available_roll_rate maximum_roll_rate_table
         regular_table
            independent_variable altitude
               units m
               0 1000 2000 3000
            end_independent_variable
            independent_variable airspeed
               units m/s
               0 15 30
            end_independent_variable
            dependent_variable
               units deg/s
               45 60 80   # 0m - higher authority at speed
               45 55 70   # 1000m
               40 50 60   # 2000m
               35 45 50   # 3000m - reduced at altitude
            end_dependent_variable
         end_regular_table
      end_table

      # -----------------------------------------------------------------------
      # Bank angle table: 35 deg operational, 60 deg maximum
      # -----------------------------------------------------------------------
      table available_bank_angle maximum_bank_angle_table
         regular_table
            independent_variable altitude
               units m
               0 1000 2000 3000
            end_independent_variable
            independent_variable airspeed
               units m/s
               0 15 30
            end_independent_variable
            dependent_variable
               units deg
               35 40 45   # 0m
               35 40 45   # 1000m
               30 35 40   # 2000m
               25 30 35   # 3000m
            end_dependent_variable
         end_regular_table
      end_table

   end_performance_tables

end_mover
